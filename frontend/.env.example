# Vercel Environment Variables
# Copy this file to Vercel or locally as .env.production

# The public URL of your AI Inference Service (e.g. AWS EC2 IP or domain)
NEXT_PUBLIC_API_URL=http://your-ec2-ip:8003

# The public URL of your Patient Management Service
NEXT_PUBLIC_PATIENT_API_URL=http://your-ec2-ip:8001

# The WebSocket URL of your AI Inference Service (ws:// or wss://)
NEXT_PUBLIC_WS_URL=ws://your-ec2-ip:8003/ws/stream
