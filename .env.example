# FetalGuard AI — Environment Configuration Template
# Copy this file to .env before deploying to production.

# ── MongoDB Database Connection ──
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/fetal_health?retryWrites=true&w=majority

# ── Authentication & Security ──
JWT_SECRET_KEY=replace_with_a_secure_random_64_character_hex_key
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── LLM Clinical Decision Support (Groq API) ──
GROQ_API_KEY=gsk_your_production_groq_api_key_here

# ── Service Endpoints ──
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
NEXT_PUBLIC_AI_URL=http://127.0.0.1:8003
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8003/ws/stream
ALLOWED_ORIGINS=http://localhost:3005,http://127.0.0.1:3005
