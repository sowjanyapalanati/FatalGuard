# ─── Database ──────────────────────────────────────────────────
DB_PASSWORD=fetal_secure_2026
DATABASE_URL=postgresql+asyncpg://admin:fetal_secure_2026@postgres:5432/fetal_health_db

# ─── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Kafka ─────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_RAW_TOPIC=ctg-raw-stream
KAFKA_PROCESSED_TOPIC=ctg-processed-stream
KAFKA_PREDICTIONS_TOPIC=ctg-predictions
KAFKA_ALERTS_TOPIC=ctg-alerts

# ─── MinIO ─────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin2026
MINIO_ENDPOINT=minio:9000

# ─── MLflow ────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=fetal-health-classification

# ─── Kaggle (for dataset download) ─────────────────────────────
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ─── PhysioNet (for CTU-UHB dataset) ───────────────────────────
PHYSIONET_USERNAME=your_physionet_username
PHYSIONET_PASSWORD=your_physionet_password

# ─── Auth ──────────────────────────────────────────────────────
JWT_SECRET_KEY=change_this_to_a_long_random_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Replay Engine ─────────────────────────────────────────────
REPLAY_INTERVAL_SECONDS=0.5
REPLAY_LOOP=true
DATASET_PATH=data/raw/kaggle_ctg.csv

# ─── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8003
NEXT_PUBLIC_WS_URL=http://localhost:8005
NEXT_PUBLIC_PATIENT_API_URL=http://localhost:8001
